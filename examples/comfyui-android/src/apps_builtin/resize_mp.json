{
  "id": "resize.mp",
  "name": "Resize to megapixels",
  "group": "Upscale",
  "description": "Scale to a total pixel budget, whatever size came in. Aim it at the source to tame a huge img2img input.",
  "version": 1,
  "requires": [{ "class": "ImageScaleToTotalPixels", "pack": "core" }],
  "knobs": [
    {
      "id": "megapixels",
      "label": "Megapixels",
      "ty": { "Float": { "min": 0.1, "max": 16.0, "step": 0.1 } },
      "default": 1.0
    },
    {
      "id": "upscale_method",
      "label": "Method",
      "ty": { "Enum": { "class": "ImageScaleToTotalPixels", "input": "upscale_method" } },
      "default": "lanczos",
      "advanced": true
    }
  ],
  "nodes": [
    {
      "id": "scale",
      "class": "ImageScaleToTotalPixels",
      "inputs": {
        "image": "$image",
        "upscale_method": "$knob:upscale_method",
        "megapixels": "$knob:megapixels"
      }
    }
  ],
  "output": { "node": "scale", "slot": 0 }
}
